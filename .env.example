# Leave the OAuth values blank for the fully local, no-write demo mode.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8787/api/auth/github/callback

# public_repo is the default and only supports public repositories.
# Use repo only if private-repository Issues are required; GitHub OAuth Apps
# cannot scope private access down to Issues or to one selected repository.
GITHUB_OAUTH_SCOPE=public_repo

# Generate a unique value of at least 32 characters. Required in OAuth mode.
SESSION_SECRET=

# Where the server returns the browser after GitHub completes sign-in.
APP_URL=http://localhost:5173/

# Optional. The server defaults to 8787.
PORT=8787

# Set only when HTTPS is terminated by one trusted reverse proxy.
TRUST_PROXY=0
