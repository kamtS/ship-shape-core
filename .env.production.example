# Copy to .env.production on the server. Never commit the real file.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://ship-shape.example/api/auth/github/callback
GITHUB_OAUTH_SCOPE=public_repo

# Generate independently: openssl rand -base64 48
SESSION_SECRET=
APP_URL=https://ship-shape.example/

# Host-only port used by the reverse proxy.
SHIP_SHAPE_PORT=8787
SHIP_SHAPE_IMAGE_TAG=local

# Conservative defaults for a small single-instance host.
APP_MEMORY_LIMIT=512m
APP_CPU_LIMIT=0.50
REDIS_MEMORY_LIMIT=192m
REDIS_CPU_LIMIT=0.25
